# ReconIQ Environment Configuration Template
APP_NAME="ReconIQ - Threat Analysis Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Threat Intelligence API Keys (a provider is enabled when its key is set)
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
URLHAUS_AUTH_KEY=""
GOOGLE_SAFE_BROWSING_API_KEY=""
HIBP_API_KEY=""
# Shodan InternetDB and RDAP need no key; set false to disable outbound keyless lookups
INTEL_KEYLESS_PROVIDERS=true

# AI Analyst: Claude writes the narrative when a key is set; otherwise a deterministic template is used.
# The analyst explains the verdict but can never change the score.
ANTHROPIC_API_KEY=""
ANALYST_ENABLED=true
ANALYST_MODEL="claude-opus-5-5"
ANALYST_EFFORT="medium"

# Persistence: SQLite file by default; any postgres:// URL works (POSTGRES_URL from Vercel storage is used as a fallback)
DATABASE_URL="sqlite:///./reconiq.db"
PERSIST_INVESTIGATIONS=true
MAX_UPLOAD_MB=15

# API security: comma-separated keys turn on authentication (X-API-Key or Bearer); 0 disables rate limiting
API_KEYS=""
RATE_LIMIT_PER_MINUTE=60

# User accounts: AUTH_ENABLED requires sign-in. Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ENABLED=false
JWT_SECRET=""
BOOTSTRAP_ADMIN_EMAIL=""
# Role for self-registered users: analyst | viewer | disabled
SIGNUP_ROLE="analyst"
